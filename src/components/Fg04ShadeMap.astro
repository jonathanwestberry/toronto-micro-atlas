---
import MapStage from './MapStage.astro';

/**
 * The shade map. Two surfaces, side by side, always both.
 *
 * The leaf-on correction reverses which neighbourhoods are shadiest, so a
 * reader who can see one surface must be able to see the other. A toggle
 * would make the reader hold an image in memory to spot the reversal, and
 * the reversal IS the finding. Two panes, and each one says in words which
 * surface it is: colour cannot carry that, because the two ramps are the
 * same ramp.
 *
 * Everything in the legend is filled in from `public/data/fg04/manifest.json`
 * at runtime, which is the same file the tiles were written with. A legend
 * carrying its own copy of the modelled date is a legend that will one day
 * disagree with the data it labels.
 *
 * The surface labels below are the pre-JS fallback and are replaced by the
 * manifest's own `surfaceLabels`. They are spelled out here rather than left
 * blank so the markup is never unlabelled.
 */
interface Props {
  id?: string;
}
const { id = 'fg04-shade' } = Astro.props as Props;

const SURFACES = [
  {
    key: 'raw',
    label: 'Measured, leaf-off',
    note: 'The surface the lidar actually recorded. Every flight over Toronto is spring, so tree shade is understated and building shade is not.',
  },
  {
    key: 'corrected',
    label: 'Leaf-on corrected',
    note: 'Bare canopy raised to a leaf-on equivalent. The generous end of the range: ground under a crown counts as shaded for the whole modelled day.',
  },
];
---

<section class="fg04-maps" data-fg04-maps aria-labelledby={`${id}-title`}>
  <h2 class="fg04-maps__title" id={`${id}-title`}>
    Explore shade by clock hour
  </h2>

  <p class="fg04-maps__standfirst">
    The same ground twice. The map on the left is what the lidar measured. The
    map on the right raises bare canopy to a leaf-on equivalent. Both are
    published because the correction changes which neighbourhoods come out
    shadiest. Choose one clock hour and both maps update together.
  </p>

  <form class="fg04-clock" data-fg04-clock>
    <label class="fg04-clock__label" for={`${id}-hour`}>Clock hour</label>
    <div class="fg04-clock__control">
      <input
        class="fg04-clock__range"
        id={`${id}-hour`}
        data-fg04-hour
        type="range"
        min="6"
        max="20"
        step="1"
        value="13"
        aria-describedby={`${id}-hour-help`}
      />
      <output
        class="fg04-clock__output"
        data-fg04-hour-output
        id={`${id}-hour-output`}
        for={`${id}-hour`}
        aria-live="polite"
      >13:00 EDT</output>
    </div>
    <p class="fg04-clock__help" id={`${id}-hour-help`}>
      Both maps use the same selected hour, from 06:00 to 20:00 EDT.
    </p>
    <noscript>
      <p class="fg04-clock__no-script">
        JavaScript is required to change the clock hour. The default view is
        13:00 EDT.
      </p>
    </noscript>
  </form>

  <div class="fg04-maps__pair">
    {
      SURFACES.map((surface) => (
        <div class="fg04-maps__pane">
          <h3 class="fg04-maps__pane-title" id={`${id}-${surface.key}-label`}>
            {surface.label}
          </h3>
          <MapStage
            label={`Shade at the selected clock hour, ${surface.label}`}
            id={`${id}-${surface.key}`}
            as="div"
            helpCorner="top-left"
          >
            <div
              class="fg04-maps__canvas"
              data-fg04-map={surface.key}
              aria-labelledby={`${id}-${surface.key}-label`}
            />
            <div slot="howto">
              <p>
                Dark ground was shaded at the selected clock hour. Light
                ground had direct sun. Both panes always use the same hour.
              </p>
              <p>
                This map shows where the sun was blocked. It says nothing
                about temperature.
              </p>
            </div>
          </MapStage>
          <p class="fg04-maps__pane-note">{surface.note}</p>
        </div>
      ))
    }
  </div>

  <div class="fg04-legend" data-fg04-legend>
    <h3 class="fg04-legend__title" data-fg04-hour-legend>
      Shade state at 13:00 EDT
    </h3>
    <ol class="fg04-legend__scale" data-fg04-legend-swatches>
      <li class="fg04-legend__item">
        <span
          class="fg04-legend__swatch fg04-legend__swatch--shaded"
          style="background: var(--fg04-selected-shaded)"
        />
        <span>Shaded at the selected hour</span>
      </li>
      <li class="fg04-legend__item">
        <span
          class="fg04-legend__swatch fg04-legend__swatch--sunlit"
          style="background: var(--fg04-selected-sunlit)"
        />
        <span>Direct sun at the selected hour</span>
      </li>
      <li class="fg04-legend__item">
        <span class="fg04-legend__swatch fg04-legend__swatch--no-data" />
        <span>Not sampled ground</span>
      </li>
    </ol>
    <p class="fg04-legend__facts" data-fg04-legend-facts>
      Selected from fifteen frames, 21 July 2026, 06:00 to 20:00 EDT, on a
      2 m grid. Lidar flown April to May 2023. The 06:00 frame sits at
      0.38&deg; above the horizon and is shaded everywhere by construction.
    </p>
  </div>

  <section class="fg04-point" data-fg04-point aria-labelledby={`${id}-point-title`}>
    <div class="fg04-point__head">
      <div>
        <h3 class="fg04-point__title" id={`${id}-point-title`}>Inspect a point</h3>
        <p class="fg04-point__instructions">
          Click or tap either map to inspect a point. With a keyboard, focus a
          map and press Enter to inspect its centre.
        </p>
      </div>
      <p
        class="fg04-point__coordinate"
        data-fg04-point-coordinate
        aria-label="Selected coordinate"
        hidden
      />
    </div>

    <p
      class="fg04-point__status"
      data-fg04-point-status
      role="status"
      aria-live="polite"
    >
      Select a point to see its shade profile from 06:00 to 20:00 EDT.
    </p>

    <div class="fg04-point__profile" data-fg04-point-profile hidden>
      <div class="fg04-point__selected" aria-live="polite">
        <p class="fg04-point__selected-time" data-fg04-point-selected-time>
          Selected hour, 13:00 EDT
        </p>
        <div class="fg04-point__selected-pair">
          <p>
            <span>Measured, leaf-off</span>
            <strong data-fg04-point-selected-measured>Unknown</strong>
          </p>
          <p>
            <span>Leaf-on corrected</span>
            <strong data-fg04-point-selected-corrected>Unknown</strong>
          </p>
        </div>
      </div>

      <p class="fg04-point__strip-key">
        Each hour has two bars: measured above, corrected below.
      </p>
      <ol
        class="fg04-point__strip"
        data-fg04-point-strip
        aria-label="Shade profile from 06:00 to 20:00 EDT"
      />

      <details class="fg04-point__details">
        <summary>Read the profile as a table</summary>
        <div class="fg04-point__table-wrap">
          <table class="fg04-point__table">
            <thead>
              <tr>
                <th scope="col">Clock hour</th>
                <th scope="col">Measured, leaf-off</th>
                <th scope="col">Leaf-on corrected</th>
              </tr>
            </thead>
            <tbody data-fg04-point-table />
          </table>
        </div>
      </details>
    </div>
  </section>
</section>

<script>
  import '../scripts/fg04-map';
</script>
