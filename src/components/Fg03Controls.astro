---
/**
 * FG03 explorer controls.
 *
 * Moved out of the guide page unchanged so the guide and the expanded map
 * route render one form, not two that drift. Every name, value, and data
 * attribute here is part of the shareable-state contract asserted by
 * tests/fg03-contract.test.mjs.
 */
import {
  defaultAction,
  defaultTime,
  defaultUrlAccess,
  defaultWalk,
  interventionCountsByAction,
  number,
} from '../data/fg03';

interface Props {
  /**
   * Put the "results update after each choice" line at the foot of the form.
   *
   * On the guide the sentence sits above a map that is right there, so it reads
   * as an introduction. On the map route the same sentence lands at the top of
   * a scrolling rail, a screen away from anything it describes, where it reads
   * as a caption for the map instead of advice about a control. At the foot it
   * sits beside Share this view, which is the other thing it is about.
   */
  helpAtFoot?: boolean;
}

const { helpAtFoot = false } = Astro.props as Props;

// Each proposal option carries how many places it holds in this snapshot, so a
// reader can see an option is empty before spending a click on it. Retrofit is
// the one that is empty today.
const proposalCount = (action: string): number =>
  interventionCountsByAction[action] ?? 0;
---

<form
  class="fg03-controls"
  data-fg03-controls
  aria-describedby="fg03-controls-help"
  aria-disabled="true"
  inert
>
  {!helpAtFoot && (
    <p id="fg03-controls-help" class="fg03-controls-help">
      Results update after each choice. The URL stores time, access, walk,
      action, selected place, and map view for sharing.
    </p>
  )}

  <div class="fg03-control-grid">
    <fieldset data-fg03-filter="time">
      <legend>Time</legend>
      <div class="fg03-choice-row">
        <label>
          <input type="radio" name="time" value="1200" checked={defaultTime === '1200'} />
          <span>Noon</span>
        </label>
        <label>
          <input type="radio" name="time" value="2030" checked={defaultTime === '2030'} />
          <span>8:30 p.m.</span>
        </label>
        <label>
          <input type="radio" name="time" value="2200" checked={defaultTime === '2200'} />
          <span>10 p.m.</span>
        </label>
        <label>
          <input type="radio" name="time" value="0030" checked={defaultTime === '0030'} />
          <span>12:30 a.m.</span>
        </label>
      </div>
    </fieldset>

    <fieldset data-fg03-filter="access">
      <legend>Access assumption</legend>
      <div class="fg03-choice-row">
        <label>
          <input
            type="radio"
            name="access"
            value="public"
            checked={defaultUrlAccess === 'public'}
          />
          <span>Public, no fare required</span>
        </label>
        <label>
          <input
            type="radio"
            name="access"
            value="rider"
            checked={defaultUrlAccess === 'rider'}
          />
          <span>TTC rider, fare gate allowed</span>
        </label>
      </div>
    </fieldset>

    <fieldset data-fg03-filter="walk">
      <legend>Network walk</legend>
      <div class="fg03-choice-row">
        <label>
          <input type="radio" name="walk" value="300" checked={defaultWalk === 300} />
          <span>300 m</span>
        </label>
        <label>
          <input type="radio" name="walk" value="400" checked={defaultWalk === 400} />
          <span>400 m</span>
        </label>
        <label>
          <input type="radio" name="walk" value="500" checked={defaultWalk === 500} />
          <span>500 m</span>
        </label>
      </div>
    </fieldset>

    <!--
      One radio group, two kinds of thing. "Current open washrooms" is what the
      city has; the other four are what I argue it should do. Reading them as a
      flat list of five is what let a reader count ten proposal squares and
      believe they were washrooms, so the group now says which is which before
      the reader clicks anything.
    -->
    <fieldset data-fg03-filter="action">
      <legend>Show on the map</legend>
      <p class="fg03-choice-group-label">What Toronto has</p>
      <div class="fg03-choice-row fg03-choice-row--actions">
        <label>
          <input
            type="radio"
            name="action"
            value="open"
            checked={defaultAction === 'open'}
          />
          <span>Current open washrooms</span>
        </label>
      </div>
      <p class="fg03-choice-group-label">What I would change (proposals, not facilities)</p>
      <div class="fg03-choice-row fg03-choice-row--actions">
        <label>
          <input
            type="radio"
            name="action"
            value="extend"
            checked={defaultAction === 'extend'}
          />
          <span class="fg03-choice-label--stacked">
            Extend hours
            <small class="fg03-choice-count">
              {proposalCount('extend') === 0
                ? 'none in this snapshot'
                : `${proposalCount('extend')} places`}
            </small>
          </span>
        </label>
        <label>
          <input
            type="radio"
            name="action"
            value="new"
            checked={defaultAction === 'new'}
          />
          <span class="fg03-choice-label--stacked">
            New facility zones
            <small class="fg03-choice-count">
              {proposalCount('new') === 0
                ? 'none in this snapshot'
                : `${proposalCount('new')} places`}
            </small>
          </span>
        </label>
        <label>
          <input
            type="radio"
            name="action"
            value="verify"
            checked={defaultAction === 'verify'}
          />
          <span class="fg03-choice-label--stacked">
            Verify published information
            <small class="fg03-choice-count">
              {proposalCount('verify') === 0
                ? 'none in this snapshot'
                : `${proposalCount('verify')} places`}
            </small>
          </span>
        </label>
        <label>
          <input
            type="radio"
            name="action"
            value="retrofit"
            checked={defaultAction === 'retrofit'}
          />
          <span class="fg03-choice-label--stacked">
            Retrofit accessibility
            <small class="fg03-choice-count">
              {proposalCount('retrofit') === 0
                ? 'none in this snapshot'
                : `${proposalCount('retrofit')} places`}
            </small>
          </span>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="fg03-control-tools">
    <div class="fg03-search">
      <label for="fg03-search">Search places</label>
      <div>
        <input
          id="fg03-search"
          type="search"
          name="search"
          autocomplete="off"
          placeholder="Name, address, source, or action"
          data-fg03-search
        />
        <button type="button" data-fg03-clear-search disabled>Clear search</button>
      </div>
    </div>
    <div class="fg03-control-actions">
      <button type="button" data-fg03-reset>Reset explorer</button>
      <button type="button" class="fg03-button--primary" data-fg03-share>
        Share this view
      </button>
    </div>
    {helpAtFoot && (
      <p id="fg03-controls-help" class="fg03-controls-help">
        Results update after each choice. The URL stores time, access, walk,
        action, selected place, and map view for sharing.
      </p>
    )}
  </div>
</form>
