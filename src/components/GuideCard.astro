---
/**
 * GuideCard: one guide in the gallery. A vivid themed title-plate (the preview)
 * over a cream editorial body. Whole card is the link when href is set;
 * forthcoming guides render as a non-interactive card. Status uses text + a
 * shaped dot so it never rides on colour alone.
 */
interface Props {
  title: string;
  description: string;
  href?: string;
  tag?: string;
  status?: 'new' | 'live' | 'forthcoming';
  theme?: 'fg01' | 'fg02' | 'fg03';
  level?: 2 | 3;
}

const { title, description, href, tag, status = 'live', theme, level = 3 } = Astro.props;
const Wrapper = href ? 'a' : 'div';
const Heading = `h${level}` as 'h2' | 'h3';
const statusLabel = status === 'new' ? 'New' : status === 'forthcoming' ? 'Forthcoming' : 'Live';
---

<Wrapper
  class:list={['guide-card', theme && `guide-card--${theme}`, !href && 'guide-card--static', href && 'hover-raise']}
  href={href}
  {...(href ? { 'data-astro-reload': true } : {})}
>
  <div class="guide-card-plate">
    <span class:list={['guide-card-status', `guide-card-status--${status}`]}>
      <span class="guide-card-status-dot" aria-hidden="true"></span>{statusLabel}
    </span>
    <Heading class="guide-card-title">{title}</Heading>
  </div>
  <div class="guide-card-meta">
    {tag && <span class="guide-card-tag">{tag}</span>}
    <p class="guide-card-desc">{description}</p>
    {href && <span class="guide-card-cta" aria-hidden="true">Open the guide &rarr;</span>}
  </div>
</Wrapper>

<style>
  .guide-card {
    /* Per-theme plate colours; default = atlas shell accent */
    --plate-bg: var(--ink);
    --plate-ink: var(--paper);
    --plate-tag: var(--paper);
    --card-accent: var(--threshold);

    display: flex;
    flex-direction: column;
    background-color: var(--card);
    border: 1px solid var(--street-minor);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* Per-guide plate palettes (all on the ONE PALETTE, all AA on their plate) */
  .guide-card--fg01 { --plate-bg: #2A5BD0; --plate-ink: #FAF6EC; --plate-tag: #CCDFF2; --card-accent: #2A5BD0; }
  .guide-card--fg02 { --plate-bg: #163A24; --plate-ink: #FAF6EC; --plate-tag: #C5DE5F; --card-accent: #45A26A; }
  .guide-card--fg03 { --plate-bg: #1A2F66; --plate-ink: #FAF6EC; --plate-tag: #F37E2A; --card-accent: #1A2F66; }

  .guide-card-plate {
    position: relative;
    background-color: var(--plate-bg);
    color: var(--plate-ink);
    padding: var(--space-6);
    min-height: 168px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  .guide-card-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--plate-ink);
    margin: 0;
  }

  .guide-card-status {
    position: absolute;
    top: var(--space-4);
    left: var(--space-6);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--plate-tag);
  }

  /* Shape carries status alongside colour: filled dot = New, ring = Live,
     hollow dot = Forthcoming */
  .guide-card-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    background-color: currentColor;
  }
  .guide-card-status--live .guide-card-status-dot { background-color: transparent; }
  .guide-card-status--forthcoming .guide-card-status-dot { background-color: transparent; opacity: 0.6; }

  .guide-card-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6) var(--space-6);
    border-top: 3px solid var(--card-accent);
    flex: 1;
  }

  .guide-card-tag {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .guide-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0;
    max-width: 46ch;
  }

  .guide-card-cta {
    margin-top: auto;
    padding-top: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--card-accent);
  }

  /* States: only interactive cards react */
  .guide-card:not(.guide-card--static) {
    transition: border-color var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) {
    a.guide-card:hover {
      border-color: var(--card-accent);
    }
  }

  a.guide-card:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .guide-card--static {
    opacity: 0.9;
  }
  .guide-card--static .guide-card-plate {
    /* Forthcoming: muted plate so live guides read as primary */
    filter: saturate(0.55);
  }
</style>
