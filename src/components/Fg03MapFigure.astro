---
/**
 * FG03 map figure: the stage, the keyboard instructions, and the legend.
 *
 * Shared by the guide and the expanded map route. `expanded` switches the
 * stage between the in-page preview (which offers "Expand map") and the
 * full-viewport route (which offers "Back to the guide").
 */
import MapStage from './MapStage.astro';
import Fg03Legend from './Fg03Legend.astro';
import { base, snapshotDate } from '../data/fg03';

interface Props {
  expanded?: boolean;
}

const { expanded = false } = Astro.props as Props;
const guideHref = `${base}/guides/when-toronto-has-to-go/`;
---

<figure class="fg03-map-figure" data-fg03-map-shell>
  <div class="fg03-map-frame">
    <MapStage
      as="div"
      id={expanded ? 'fg03-map-route' : 'fg03-map-stage'}
      class:list={['fg03-map-stage', { 'map-stage--expanded': expanded }]}
      label="Toronto public washroom access and audited interventions"
      helpCorner="top-left"
      status={false}
      expanded={expanded}
      backHref={expanded ? guideHref : undefined}
      expandPath={expanded ? undefined : `${base}/guides/when-toronto-has-to-go/map`}
    >
    <div
      class="fg03-map"
      data-map-canvas
      data-fg03-map
      role="region"
      tabindex="-1"
      aria-disabled="true"
      aria-label="Interactive map of Toronto public washroom access and audited interventions"
      aria-describedby="fg03-map-instructions"
      inert
    >
      <svg
        class="fg03-map-paper"
        viewBox="0 0 720 540"
        role="img"
        aria-label="Quiet outline of Toronto before the interactive map loads"
        preserveAspectRatio="xMidYMid slice"
      >
        <path
          class="fg03-map-shore"
          d="M42 75L146 46L298 59L420 34L628 74L680 160L647 278L584 326L523 386L410 423L274 466L146 438L70 339L33 205Z"
        />
        <path class="fg03-map-water" d="M0 407L125 382L279 422L442 385L594 329L720 301V540H0Z" />
        <path class="fg03-map-line" d="M125 86L211 168L314 222L430 300L592 358" />
        <path class="fg03-map-line" d="M84 286L208 260L356 245L503 210L639 142" />
        <path class="fg03-map-line fg03-map-line--secondary" d="M251 66L269 177L303 290L355 418" />
        <path class="fg03-map-line fg03-map-line--secondary" d="M454 63L433 168L450 280L501 379" />
        <circle class="fg03-map-mark fg03-map-mark--open" cx="359" cy="325" r="7" />
        <rect class="fg03-map-mark fg03-map-mark--extend" x="250" y="234" width="14" height="14" />
        <path class="fg03-map-mark fg03-map-mark--new" d="M519 171L528 188H510Z" />
        <path class="fg03-map-mark fg03-map-mark--verify" d="M165 297L175 307L165 317L155 307Z" />
      </svg>
      <p class="fg03-map-loading-label" aria-hidden="true">
        Dated Toronto evidence is ready. The interactive layers load near this map.
      </p>

      <!--
        What you are looking at, inside the frame that is showing it. The only
        state readout used to be the grey sentence under the controls, which on
        the map route sits below the fold and on a phone is 1,600px above the
        map: by the time a reader is looking at dots, nothing on screen says
        which hour, which fare rule, or how many. Aria-hidden because the
        role="status" sentence already announces the same change, and two live
        regions saying it twice is worse than one saying it once.
      -->
      <div class="fg03-map-title" data-fg03-map-title aria-hidden="true" hidden>
        <p class="fg03-map-title-count" data-fg03-map-title-count></p>
        <p class="fg03-map-title-filters" data-fg03-map-title-filters></p>
      </div>

      <!--
        A search that matches nothing emptied the map and said so 205px below
        the fold, so the map read as broken while the filters still claimed a
        time and a category. The card says it on the canvas the reader is
        looking at, and carries the way out with it.
      -->
      <div class="fg03-map-veil" data-fg03-map-veil hidden>
        <p data-fg03-map-veil-message></p>
        <button type="button" data-fg03-map-veil-action hidden>Clear search</button>
      </div>

      <!--
        The phone version of the detail panel. Scrolling to the real panel is
        right on a desktop, where it is a column away; at 390px it is roughly
        2,600px down, so a tap on a marker threw the map off screen with no way
        back. Below 900px the record docks here instead, and the link is what
        takes a reader to the full record if they want it.
      -->
      <div
        class="fg03-map-card"
        data-fg03-map-card
        role="group"
        aria-label="Selected place"
        hidden
      >
        <div class="fg03-map-card-head">
          <h4 data-fg03-map-card-title></h4>
          <button
            type="button"
            data-fg03-map-card-close
            aria-label="Clear the selected place"
          >Close</button>
        </div>
        <dl data-fg03-map-card-body></dl>
        <button type="button" data-fg03-map-card-more>Read the full record</button>
      </div>
    </div>

      <Fragment slot="howto">
        {/*
          This was a sentence naming six shapes and no swatches, which asked a
          reader to hold a description in their head and go hunting for a match.
          Two of the names were also wrong: the diamond was called a record
          needing verification when the solid one is a fare-paid facility, and
          the cross was called an accessibility retrofit when the amber one
          means the data is missing. Showing the drawn marks removes both the
          translation and the chance of mislabelling one.
        */}
        <p>
          Each shape is a different kind of place, so the map reads without relying
          on colour.
        </p>
        <Fg03Legend id="fg03-howto-legend" heading={false} />
        <p>
          The filters above the map set the hour, the fare condition, and how far you
          are willing to walk. Everything shown on the map is also in the ranked list
          below it, so nothing here is map-only.
        </p>
        <p>
          Focus the map and use arrow keys to pan, plus and minus to zoom, and Enter to
          inspect the place at the centre.
        </p>
        <p>
          The page address tracks what you are looking at, so copying the URL shares
          this exact view: the hour, the fare setting, the walking distance, the
          selected place, and where the map is pointed.
        </p>
      </Fragment>

    </MapStage>

    <p id="fg03-map-instructions" class="fg03-map-instructions">
      Focus the map and use arrow keys to pan. Use plus and minus to zoom.
      Press Enter to inspect the place at the map centre. Every mapped result
      is also available in the ranked list.
    </p>

    <Fg03Legend />

    <figcaption>
      <span data-fg03-caption-snapshot>Snapshot: {snapshotDate}</span>
      <span data-fg03-caption-attribution>
        Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>.
        City data under the{' '}
        <a href="https://open.toronto.ca/open-data-license/">
          Open Government Licence - Toronto
        </a>.
      </span>
    </figcaption>
  </div>
</figure>
