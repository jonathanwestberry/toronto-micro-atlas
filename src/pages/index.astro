---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const guides = (await getCollection('guides')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const newestTime = Math.max(...guides.map((g) => g.data.published.getTime()));
---

<Base
  title={undefined}
  description="An independent atlas of interactive field guides, each one turning a single Toronto system into a map you can read."
>
  <div class="home">

    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-eyebrow"><span class="hero-mark" aria-hidden="true"></span>Toronto Micro-Atlas</p>
          <h1 class="hero-title" id="hero-title">Field guides to a city you think you know</h1>
          <p class="hero-lede">
            An independent atlas of interactive field guides. Each one takes a single system the
            city runs, its street trees, its buried ravines, its late-night washrooms, and turns
            the public record into a map you can actually read.
          </p>
          <div class="hero-actions">
            <a class="hero-cta" href={`${base}/guides/`}>Browse the field guides &rarr;</a>
            <span class="hero-count">{guides.length} guides live</span>
          </div>
        </div>
        <div class="hero-map" aria-hidden="true">
          <img src={`${base}/hero/toronto-hero.svg`} alt="" width="1600" height="1160" />
        </div>
      </div>
    </section>

    <!-- The gallery: every guide, as a peer -->
    <section class="gallery" aria-labelledby="gallery-heading">
      <div class="gallery-inner">
        <div class="gallery-head">
          <h2 class="gallery-heading" id="gallery-heading">The field guides</h2>
          <a class="gallery-all" href={`${base}/guides/`}>All guides and what's under research &rarr;</a>
        </div>
        <ul class="gallery-grid" role="list">
          {
            guides.map((g) => (
              <li>
                <GuideCard
                  title={g.data.title}
                  description={g.data.description}
                  href={`${base}/guides/${g.data.slug}/`}
                  tag={g.data.subjectTag}
                  theme={g.data.theme}
                  cover={`${base}/hero/thumbs/${g.data.slug}.webp`}
                  status={g.data.published.getTime() === newestTime ? 'new' : 'live'}
                  level={3}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- What this is -->
    <section class="about-band" aria-labelledby="about-heading">
      <div class="about-inner">
        <p class="about-kicker" id="about-heading">What a field guide is</p>
        <p class="about-lede">
          Not a listicle and not a review. Each one starts from a record the city already keeps,
          checks it, and draws it. Read straight through for the argument, or open the map and go
          looking for your own street. More guides are under research.
        </p>
        <a class="about-cta" href={`${base}/guides/`}>Open a guide &rarr;</a>
      </div>
    </section>

  </div>
</Base>

<style>
  .home { display: flex; flex-direction: column; }

  /* ============================ Hero ============================ */
  .hero {
    padding-inline: var(--gutter);
    padding-block: var(--space-16) var(--space-12);
    border-bottom: 1px solid var(--street-minor);
    overflow: hidden;
  }
  @media (min-width: 1024px) { .hero { padding-block: var(--space-24) var(--space-16); } }

  .hero-inner {
    max-width: var(--container);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10, 2.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--space-16); }
  }

  .hero-text { display: flex; flex-direction: column; align-items: flex-start; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: var(--space-6);
  }
  /* The atlas mark: a survey dot (matches favicon) */
  .hero-mark {
    width: 0.75rem; height: 0.75rem; border-radius: 50%;
    background-color: var(--threshold);
    box-shadow: 0 0 0 3px var(--card), 0 0 0 4px var(--threshold);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-weight: 400; /* Bebas is single-weight */
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    max-width: 14ch;
  }

  .hero-lede {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 46ch;
    margin: var(--space-6) 0 var(--space-8);
  }

  .hero-actions { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .hero-cta {
    display: inline-block;
    background-color: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--ink);
    border-radius: 2px;
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }
  @media (hover: hover) {
    .hero-cta:hover { background-color: var(--threshold); border-color: var(--threshold); color: var(--paper); }
  }
  .hero-cta:focus-visible { outline: 2px solid var(--threshold); outline-offset: 3px; }
  .hero-count {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero-map {
    position: relative;
  }
  .hero-map img {
    width: 100%;
    height: auto;
    display: block;
    /* let the cream of the map blend into the cream page */
    filter: drop-shadow(0 12px 30px rgba(39, 36, 29, 0.08));
  }
  @media (max-width: 899px) {
    .hero-map { margin-top: var(--space-4); max-width: 560px; }
  }

  /* ============================ Gallery ============================ */
  .gallery {
    padding-inline: var(--gutter);
    padding-block: var(--space-16);
  }
  .gallery-inner { max-width: var(--container); margin-inline: auto; }
  .gallery-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }
  .gallery-heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }
  .gallery-all {
    position: relative;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--atlas-accent-text);
    text-decoration: none;
  }

  /* SC 2.5.8: grown with a pseudo-element rather than padding, so the hit
     area changes and the layout does not. Same technique as the site nav. */
  .gallery-all::before,
  .about-cta::before {
    content: '';
    position: absolute;
    inset: -6px -4px;
  }
  .gallery-all:hover { text-decoration: underline; }
  .gallery-all:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 640px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gallery-grid { grid-template-columns: repeat(3, 1fr); } }

  /* ============================ About band ============================ */
  .about-band {
    padding-inline: var(--gutter);
    padding-block: var(--space-16) var(--space-24);
    border-top: 1px solid var(--street-minor);
  }
  .about-inner { max-width: var(--container); margin-inline: auto; }
  .about-kicker {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--space-4);
  }
  .about-lede {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    line-height: 1.5;
    color: var(--ink);
    max-width: 40ch;
    margin: 0 0 var(--space-6);
  }
  .about-cta {
    position: relative;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--atlas-accent-text);
    text-decoration: none;
  }
  .about-cta:hover { text-decoration: underline; }
  .about-cta:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
</style>
