---
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const guides = (await getCollection('guides')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const featured = guides.find((g) => g.data.featured) ?? guides[0];
const rest = guides.filter((g) => g.id !== featured.id);
---

<Base
  title={undefined}
  description="An independent web publication of interactive field guides about noticing and using Toronto."
>
  <div class="home-wrapper">

    <!-- Publication masthead -->
    <section class="home-lede" aria-labelledby="site-title">
      <div class="home-lede-inner">
        <h1 class="site-title" id="site-title">Toronto&nbsp;Micro-Atlas</h1>
        <hr class="lede-rule" aria-hidden="true" />
        <p class="lede-text" data-reveal>
          An independent web publication of interactive field guides about noticing and using
          Toronto. Each guide takes one specific way the city works, where it hides things, what it
          shows someone paying attention, and builds it into a researched, interactive map.
        </p>
      </div>
    </section>

    <!-- Featured guide -->
    <section
      class="feature-block feature-block--fg3"
      id="featured"
      aria-labelledby="feature-title-fg3"
    >
      <div class="feature-inner">
        <div class="feature-text">
          <span class="feature-kicker">
            <span class="feature-kicker-dot" aria-hidden="true"></span>New guide
          </span>
          <h2 class="feature-title" id="feature-title-fg3">
            {featured.data.title}
          </h2>
          <p class="feature-blurb">
            At 10 p.m., scheduled transit still reaches 7,994 grouped points while only six
            unrestricted washroom access points are documented open. This guide publishes the dated
            proof and, only when its evidence gate passes, lets you test audited ways to close the
            gap.
          </p>
          <a
            href={`${base}/guides/${featured.data.slug}/`}
            class="feature-cta hover-raise"
            data-astro-reload
          >Open the guide</a>
        </div>
        <div class="feature-plate" aria-hidden="true">
          <span class="feature-plate-metric">7,994</span>
          <span class="feature-plate-label">transit points reachable</span>
          <span class="feature-plate-metric feature-plate-metric--alarm">6</span>
          <span class="feature-plate-label">washrooms documented open</span>
          <span class="feature-plate-time">10:00 PM snapshot</span>
        </div>
      </div>
    </section>

    <!-- Gallery of the remaining guides -->
    <section class="home-gallery" aria-labelledby="gallery-heading">
      <div class="home-gallery-inner">
        <div class="home-gallery-head">
          <h2 class="section-label" id="gallery-heading">More field guides</h2>
          <a class="home-gallery-all" href={`${base}/guides/`}>All guides &rarr;</a>
        </div>
        <ul class="guides-grid" role="list">
          {
            rest.map((g) => (
              <li>
                <GuideCard
                  title={g.data.title}
                  description={g.data.description}
                  href={`${base}/guides/${g.data.slug}/`}
                  tag={g.data.subjectTag}
                  theme={g.data.theme}
                  status="live"
                  level={3}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- What this is -->
    <section class="home-about" aria-labelledby="about-heading">
      <div class="home-about-inner">
        <h2 class="section-label" id="about-heading">What a field guide is</h2>
        <p class="home-about-lede" data-reveal>
          Not a listicle and not a review. Each guide is a single, researched way of seeing one
          system in the city, drawn straight from public records and rendered as a map you can read,
          zoom, and search. More guides are under research.
        </p>
        <a class="home-about-cta" href={`${base}/guides/`}>Browse the field guides &rarr;</a>
      </div>
    </section>

  </div>
</Base>

<style>
  .home-wrapper { display: flex; flex-direction: column; }

  /* ---- Publication masthead ---- */
  .home-lede {
    padding-block: var(--space-16) var(--space-12);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--street-minor);
  }
  @media (max-width: 767px) {
    .home-lede { padding-block: var(--space-12) var(--space-8); }
  }
  .home-lede-inner { max-width: var(--container); margin-inline: auto; }

  .site-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--space-4);
  }
  .lede-rule {
    border: none;
    border-top: 1px solid var(--street-minor);
    margin-bottom: var(--space-8);
    max-width: var(--measure-lede);
  }
  .lede-text {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.65;
    color: var(--ink-2);
    max-width: var(--measure-lede);
  }

  /* ---- Featured guide (fg03 navy + orange) ---- */
  .feature-block {
    padding-block: var(--space-16);
    padding-inline: var(--gutter);
  }
  @media (min-width: 768px) { .feature-block { padding-block: var(--space-24); } }

  .feature-block--fg3 { background-color: #1A2F66; }

  .feature-inner {
    max-width: var(--container);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .feature-inner { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--space-16); }
  }

  .feature-text { display: flex; flex-direction: column; gap: var(--space-6); }

  .feature-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #F7A25E; /* lightened Hot Orange: AA on navy for small text */
  }
  .feature-kicker-dot {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background-color: #F37E2A;
  }

  .feature-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(2.75rem, 8vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
  }

  .feature-blurb {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--paper);
    max-width: 55ch;
  }

  .feature-cta {
    display: inline-block;
    align-self: flex-start;
    background-color: #F37E2A;
    color: #17182b;
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 1px solid #F37E2A;
    border-radius: 1px;
  }
  @media (hover: hover) {
    .feature-cta:hover { background-color: var(--paper); border-color: var(--paper); color: #1A2F66; }
  }
  .feature-cta:focus-visible { outline: 2px solid #F37E2A; outline-offset: 3px; }

  /* Featured data plate */
  .feature-plate {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    border: 1px solid rgba(250, 246, 236, 0.2);
    padding: var(--space-6);
    background-color: #142451;
  }
  .feature-plate-metric {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: var(--text-4xl);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--paper);
  }
  .feature-plate-metric--alarm { color: #F7A25E; }
  .feature-plate-label {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: rgba(250, 246, 236, 0.82);
    align-self: center;
  }
  .feature-plate-time {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(250, 246, 236, 0.62);
  }

  /* ---- Gallery ---- */
  .home-gallery {
    padding-block: var(--space-16);
    padding-inline: var(--gutter);
  }
  .home-gallery-inner { max-width: var(--container); margin-inline: auto; }
  .home-gallery-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }
  .home-gallery-all {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--threshold);
    text-decoration: none;
  }
  .home-gallery-all:hover { text-decoration: underline; }
  .home-gallery-all:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

  .guides-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 640px) { .guides-grid { grid-template-columns: repeat(2, 1fr); } }

  .section-label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0;
  }

  /* ---- What this is ---- */
  .home-about {
    padding-block: var(--space-16) var(--space-24);
    padding-inline: var(--gutter);
    border-top: 1px solid var(--street-minor);
  }
  .home-about-inner { max-width: var(--container); margin-inline: auto; }
  .home-about-lede {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 58ch;
    margin: var(--space-6) 0 var(--space-6);
  }
  .home-about-cta {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--threshold);
    text-decoration: none;
  }
  .home-about-cta:hover { text-decoration: underline; }
  .home-about-cta:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
</style>
