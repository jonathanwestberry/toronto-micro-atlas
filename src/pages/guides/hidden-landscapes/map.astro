---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import MapStage from '../../../components/MapStage.astro';
import GuidePanel from './_GuidePanel.astro';
import HowToRead from './_HowToRead.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const allLocations = await getCollection('locations', ({ data }) => data.guide === 'hidden-landscapes');
const locations = allLocations.sort((a, b) => a.data.order - b.data.order);

const mapLocations = locations.map((loc) => ({
  slug: loc.data.slug,
  title: loc.data.title,
  thresholdLabel: loc.data.thresholdLabel,
  thresholdType: loc.data.thresholdType,
  lat: loc.data.lat,
  lng: loc.data.lng,
  preview: loc.data.preview,
  url: `${base}/guides/hidden-landscapes/${loc.data.slug}/`,
  order: loc.data.order,
}));

const guideHref = `${base}/guides/hidden-landscapes/`;
---

<Base
  title="Hidden Landscapes map"
  description="The full Hidden Landscapes map: eight thresholds where Toronto's grid gives way to ravine, valley, and buried watercourse."
  canonicalPath="/guides/hidden-landscapes/"
  fullHeight
  guideTheme="fg01"
>
  <div class="map-route fg01">
    <h1 class="visually-hidden">Hidden Landscapes, full map</h1>

    <MapStage
      id="fg01-map-route"
      class="map-stage--expanded"
      label="Full map of Hidden Landscapes threshold locations"
      expanded
      backHref={guideHref}
      helpCorner="top-right"
    >
      <div
        class="guide-map-container"
        id="guide-map"
        data-map-canvas
        role="img"
        aria-label="Map of Hidden Landscapes threshold locations in Toronto"
      >
        <div class="guide-map-placeholder" aria-hidden="true">
          <span class="guide-map-placeholder-label">Map</span>
        </div>
        <noscript>
          <p class="guide-map-noscript">
            Enable JavaScript to load the interactive map, or
            <a href={guideHref}>read the eight entries in the guide</a>.
          </p>
        </noscript>
      </div>

      <!--
        This route shipped with no panel at all, so collectPanelRefs() returned
        null and populatePanel, showSelectedPanel and announce all early-returned.
        Clicking a pin flew the camera and then said nothing: no name, no legend,
        no way into the entry. The panel floats here rather than sitting in flow,
        because on this route the map is the whole page and there is no "below".
      -->
      <GuidePanel count={locations.length} floating titleAs="p">
        <Fragment slot="welcome">
          <p class="guide-panel-welcome">
            Eight thresholds. Select a symbol to preview it.
          </p>
          <!--
            SC 2.5.8. At phone width five midtown markers overlap (Nordheimer
            Ravine and Baldwin Steps sit 6px apart at 320), and they cannot be
            spread without the map lying about where they are. The guide page
            has its location cards as the same-page equivalent; this route had
            only a link to another page. The names are that equivalent here,
            and they select through the same path as a marker press. Collapsed by
            default so the panel's key stays in view.
          -->
          <details class="guide-panel-places-wrap">
            <summary class="guide-panel-places-summary">Or choose one by name</summary>
          <ul class="guide-panel-places" aria-label="The eight thresholds">
            {locations.map((loc) => (
              <li>
                <button type="button" class="guide-panel-place" data-select-place={loc.data.slug}>
                  {loc.data.title}
                </button>
              </li>
            ))}
          </ul>
          </details>
        </Fragment>
      </GuidePanel>

      <HowToRead slot="howto" expanded />

      <Fragment slot="status-fallback">
        <a class="map-stage__btn" href={guideHref}>Read the entries instead</a>
      </Fragment>
    </MapStage>

    <script is:inline type="application/json" id="guide-map-data" set:html={JSON.stringify(mapLocations)}></script>
    <div class="visually-hidden" id="guide-map-announcer" role="status" aria-live="polite"></div>
  </div>

  <script>
    import { initGuideMap } from '../../../scripts/guide-map';
    import { wirePanelScrollStop } from './_panel-scroll-stop';

    // No backHref needed: the Back link is already in the DOM as
    // [data-map-back], and MapStage reads it from there for Escape.
    const boot = () => initGuideMap({ expanded: true });

    wirePanelScrollStop();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
    document.addEventListener('astro:page-load', boot);
  </script>
</Base>

<style>
  .guide-panel-places-wrap {
    margin-top: var(--space-3);
  }

  .guide-panel-places-summary {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    cursor: pointer;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .guide-panel-places-summary:hover {
    color: var(--ink);
  }

  .guide-panel-places-summary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .guide-panel-places {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  /* One name per row, 28px tall against the 24px minimum. */
  .guide-panel-place {
    display: block;
    width: 100%;
    min-height: 28px;
    padding: var(--space-1) 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--street-minor);
    cursor: pointer;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-align: left;
    transition: color 0.1s ease;
  }

  .guide-panel-place:hover {
    color: var(--ink);
  }

  .guide-panel-place:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-panel-place {
      transition: none;
    }
  }

  .map-route {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<style is:global>
  /* On this route the canvas is the page, so it fills the stage outright
     rather than sitting at the guide page's editorial aspect ratio. */
  body[data-full-height] .map-stage--expanded {
    flex: 1;
    min-height: 0;
  }

  body[data-full-height] .map-stage--expanded .map-stage__frame {
    flex: 1;
    min-height: 0;
  }

  body[data-full-height] .map-stage--expanded .guide-map-container {
    height: 100%;
    min-height: 0;
  }
</style>
