---
import Base from '../../../layouts/Base.astro';
import Fg03Controls from '../../../components/Fg03Controls.astro';
import Fg03Status from '../../../components/Fg03Status.astro';
import Fg03MapFigure from '../../../components/Fg03MapFigure.astro';
import Fg03Results from '../../../components/Fg03Results.astro';
import '../../../styles/fg03.css';
import {
  accessLabelFor,
  actionLabels,
  actionStatusLabels,
  base,
  closureLabelFor,
  config,
  defaultAction,
  defaultPhase1,
  defaultResults,
  defaultSnapshotLabel,
  defaultTime,
  defaultUrlAccess,
  defaultWalk,
  facilities,
  gatePassed,
  guideDescription,
  interventions,
  manifest,
  number,
  riderConditionalCount,
  safePublishedHref,
  snapshotDate,
  snapshotDirectory,
  snapshots,
  sourceLabelFor,
} from '../../../data/fg03';
---

<Base
  title="When Toronto Has to Go"
  description={guideDescription}
  ogImage="/social/og-when-toronto-has-to-go.jpg"
  guideTheme="fg03"
  articlePublished="2026-07-25"
  articleUpdated="2026-07-25"
  articleAuthor="Jonathan Westberry"
>
  <article
    class="fg03"
    data-fg03-root
    data-fg03-runtime="progressive"
    data-fg03-snapshot-date={manifest.snapshotDate}
    data-fg03-gate-status={gatePassed ? 'passed' : 'failed'}
  >
    <header class="fg03-hero">
      <div class="fg03-container">
        <nav class="fg03-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href={`${base}/`}>Atlas</a></li>
            <li><a href={`${base}/guides/`}>Field guides</a></li>
            <li aria-current="page">When Toronto Has to Go</li>
          </ol>
        </nav>

        <div class="fg03-hero-grid">
          <div>
            <p class="fg03-kicker">Public access & time</p>
            <h1>When Toronto Has to Go</h1>
          </div>
          <p class="fg03-hero-deck">
            Toronto’s documented public washroom network does not fade gradually after
            work. It falls off a cliff while scheduled transit keeps moving.
          </p>
        </div>

        <div class="fg03-finding" data-fg03-central-finding="phase1Grouped">
          <p class="fg03-finding-label">The {defaultSnapshotLabel} finding</p>
          <p class="fg03-finding-statement">
            <strong>{number.format(defaultPhase1.unrestrictedOpenAccessPointCount)}</strong>{' '}
            unrestricted washroom access points remain documented open for{' '}
            <strong>{number.format(defaultPhase1.activeTransitPointCount)}</strong>{' '}
            grouped transit points with scheduled activity. Only{' '}
            <strong>{number.format(defaultPhase1.unrestrictedCoveredTransitPointCount)}</strong>{' '}
            of those transit points are within a {number.format(defaultWalk)} m
            pedestrian-network walk.
          </p>
          <p class="fg03-finding-note">
            These are Phase 1 grouped transit point counts, not raw stop-platform
            records, ridership, or passenger demand.
          </p>
        </div>
      </div>
    </header>

    <section class="fg03-proof fg03-container" aria-labelledby="fg03-proof-title">
      <div class="fg03-section-lead">
        <p class="fg03-eyebrow">Four snapshots, one weekday</p>
        <h2 id="fg03-proof-title">Access collapses on a clock</h2>
        <p>
          Each snapshot asks the same question: which unrestricted washrooms are
          documented open, which grouped transit points still have scheduled activity,
          and which of those points fall within a 400 m network walk?
        </p>
      </div>

      <ol class="fg03-snapshot-strip" aria-label="Phase 1 grouped snapshot evidence">
        {
          snapshots.map(({ id, label, phase1 }) => (
            <li data-fg03-snapshot={id}>
              <p class="fg03-snapshot-time">{label}</p>
              <div class="fg03-snapshot-measure">
                <strong>{number.format(phase1.unrestrictedOpenAccessPointCount)}</strong>
                <span>unrestricted open access points</span>
              </div>
              <div class="fg03-snapshot-measure">
                <strong>{number.format(phase1.activeTransitPointCount)}</strong>
                <span>active grouped transit points</span>
              </div>
              <div class="fg03-snapshot-measure">
                <strong>{number.format(phase1.unrestrictedCoveredTransitPointCount)}</strong>
                <span>grouped transit points covered within 400 m</span>
              </div>
              <p class="fg03-unit">Unit: {phase1.unit}</p>
            </li>
          ))
        }
      </ol>

      <div class="fg03-access-caveat" data-fg03-rider-conditional-count={riderConditionalCount}>
        <p class="fg03-access-caveat-number">{riderConditionalCount}</p>
        <div>
          <h3>Fare-gate washrooms are a separate network</h3>
          <p>
            The TTC reports{' '}
            <strong>{number.format(riderConditionalCount)}</strong>{' '}
            fare-gate facility records open at every snapshot. They require paid-area
            access, so they never seed the public coverage finding. Turn on “TTC rider
            access” in the explorer to test that different assumption.
          </p>
        </div>
      </div>

      <div class="fg03-grain-note" role="group" aria-labelledby="fg03-grain-title">
        <div>
          <p class="fg03-eyebrow">Do not combine these denominators</p>
          <h3 id="fg03-grain-title">Two phases, two counting grains</h3>
          <p>
            Phase 1 groups related stop records into transit points for the public
            finding above. Phase 2 retains individual GTFS stops and platforms for
            the intervention audit below. The explorer’s Current open count uses
            facility records, while the proof groups co-located unrestricted records
            into access points.
          </p>
        </div>
        <table>
          <caption>Late-night counts by analysis grain</caption>
          <thead>
            <tr>
              <th scope="col">Snapshot</th>
              <th scope="col">Phase 1 grouped transit points</th>
              <th scope="col">Phase 2 GTFS stops and platforms</th>
            </tr>
          </thead>
          <tbody>
            {
              snapshots
                .filter(({ id }) => id === '2200' || id === '0030')
                .map(({ label, phase1, phase2 }) => (
                  <tr>
                    <th scope="row">{label}</th>
                    <td>
                      {number.format(phase1.unrestrictedCoveredTransitPointCount)} of{' '}
                      {number.format(phase1.activeTransitPointCount)} covered
                    </td>
                    <td>
                      {number.format(phase2.unrestrictedCoveredStopCount)} of{' '}
                      {number.format(phase2.activeStopCount)} covered
                    </td>
                  </tr>
                ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      gatePassed ? (
        <section
          class="fg03-explorer fg03-container"
          aria-labelledby="fg03-explorer-title"
          data-fg03-gate="passed"
        >
          <div class="fg03-section-lead fg03-section-lead--explorer">
            <p class="fg03-eyebrow">Audited opportunities</p>
            <h2 id="fg03-explorer-title">What would close the gap?</h2>
            <p>
              The recommendation gate passed {number.format(manifest.gate.auditedOpportunityCount)}{' '}
              manually audited opportunities. Change one assumption at a time, then
              compare the ranked places that gain scheduled transit service within the
              selected walk.
            </p>
          </div>

          <Fg03Controls />
          <Fg03Status />
          <div class="fg03-explorer-grid">
            <Fg03MapFigure />

            <Fg03Results />
          </div>

          <noscript>
            <div class="fg03-no-js" data-fg03-no-js>
              <h3>The proof does not require JavaScript</h3>
              <p>
                The four snapshot findings and the complete default extend-hours
                ranking are already in this page. Interactive filters and the map need
                JavaScript. Use each “Read the evidence” disclosure or download the
                full GeoJSON and CSV files below.
              </p>
            </div>
          </noscript>
        </section>
      ) : (
        <section class="fg03-gate-failed fg03-container" data-fg03-gate="failed">
          <p class="fg03-eyebrow">Recommendation gate</p>
          <h2>Proof published, recommendations withheld</h2>
          <p>
            The four-snapshot evidence above remains valid and attributable. The
            intervention audit did not pass every product-gate condition, so this
            edition does not publish rankings or recommendation map layers.
          </p>
          <p>Gate reason: {manifest.gate.reason}</p>
        </section>
      )
    }

    <template data-fg03-gate-failed-template>
      <section class="fg03-gate-failed" data-fg03-gate="failed">
        <p class="fg03-eyebrow">Recommendation gate</p>
        <h2>Proof published, recommendations withheld</h2>
        <p>
          The dated proof remains readable. Rankings and recommendation map layers
          stay unavailable until every product-gate condition passes.
        </p>
      </section>
    </template>

    <section class="fg03-notes fg03-container" aria-label="Guide documentation">
      <div class="fg03-notes-index">
        <p class="fg03-eyebrow">Read the record</p>
        <nav aria-label="Guide documentation">
          <a href="#method">Method</a>
          <a href="#definitions">Definitions</a>
          <a href="#limitations">Limitations</a>
          <a href="#sources">Sources</a>
          <a href="#downloads">Downloads</a>
          <a href="#credits">Credits</a>
        </nav>
      </div>

      <div class="fg03-note-grid">
        <section id="method">
          <p class="fg03-eyebrow">Method</p>
          <h2>What the analysis actually measures</h2>
          <ol>
            <li>
              Consolidate {number.format(facilities.features.length)} in-boundary
              facility locations from Parks, libraries, civic buildings, museums,
              automated washrooms, and TTC stations.
            </li>
            <li>
              Normalize published hours while preserving unknown hours, live closures,
              partial service, and fare-paid access as distinct states.
            </li>
            <li>
              Read scheduled TTC activity in four 30-minute windows on Tuesday,
              {snapshotDate}. Scheduled activity measures service supply, not use.
            </li>
            <li>
              Snap facilities and transit stops to Toronto’s pedestrian network, then
              include each snap offset in the 300 m, 400 m, and 500 m shortest-path
              tests.
            </li>
            <li>
              Publish an intervention only after the candidate geometry and material
              coverage gain pass manual audit.
            </li>
          </ol>
        </section>

        <section id="definitions">
          <p class="fg03-eyebrow">Definitions</p>
          <h2>Terms that change the result</h2>
          <dl>
            <div>
              <dt>Unrestricted access</dt>
              <dd>No transit fare or controlled-area entry is required.</dd>
            </div>
            <div>
              <dt>Rider-conditional access</dt>
              <dd>A TTC washroom is available after entering the fare-paid area.</dd>
            </div>
            <div>
              <dt>Documented open</dt>
              <dd>Published hours and live closure data support an open state at the snapshot.</dd>
            </div>
            <div>
              <dt>Unknown hours</dt>
              <dd>The source confirms a facility but does not support an open or closed conclusion.</dd>
            </div>
            <div>
              <dt>Covered</dt>
              <dd>The complete pedestrian-network distance, including snap offsets, is within the selected walk.</dd>
            </div>
            <div>
              <dt>Active transit point</dt>
              <dd>A grouped Phase 1 transit location with scheduled activity in the observation window.</dd>
            </div>
          </dl>
        </section>

        <section id="limitations">
          <p class="fg03-eyebrow">Limitations</p>
          <h2>What this map cannot promise</h2>
          <ul>
            {manifest.limitations.map((limitation) => <li>{limitation}</li>)}
            <li>
              Published hours and closures can lag real conditions. Treat every
              location as documented evidence, not a guarantee of entry.
            </li>
            <li>
              A route within the distance threshold may still include slope, surface,
              curb, construction, or personal-safety barriers not represented here.
            </li>
          </ul>
        </section>

        <section id="sources">
          <p class="fg03-eyebrow">Sources</p>
          <h2>Public records behind the guide</h2>
          <ul>
            <li><a href="https://open.toronto.ca/dataset/washroom-facilities/">Toronto Park Washroom Facilities</a></li>
            <li><a href="https://open.toronto.ca/dataset/library-branch-general-information/">Toronto Public Library Branch General Information</a></li>
            <li><a href="https://open.toronto.ca/dataset/corporate-real-estate-management-portfolio-washrooms/">Corporate Real Estate Management Portfolio Washrooms</a></li>
            <li><a href="https://open.toronto.ca/dataset/museums-and-cultural-centres/">Toronto Museums and Cultural Centres</a></li>
            <li><a href="https://open.toronto.ca/dataset/street-furniture-public-washroom/">Automated Public Washrooms</a></li>
            <li><a href="https://www.ttc.ca/riding-the-ttc/Washrooms-at-TTC-subway-stations">TTC station washrooms</a></li>
            <li><a href="https://open.toronto.ca/dataset/pedestrian-network/">Toronto Pedestrian Network</a></li>
            <li><a href="https://www.ttc.ca/transparency-and-accountability/open-data">TTC scheduled transit data</a></li>
          </ul>
        </section>

        <section id="downloads">
          <p class="fg03-eyebrow">Downloads</p>
          <h2>Inspect the evidence yourself</h2>
          <ul class="fg03-downloads">
            <li><a href={manifest.files.facilities} download>Download facilities (GeoJSON)</a></li>
            <li><a href={manifest.files.interventions} download>Download interventions (GeoJSON)</a></li>
            <li><a href={`/data/fg03/${snapshotDirectory}/manifest.json`} download>Download dataset manifest (JSON)</a></li>
            <li>
              <a href={`https://raw.githubusercontent.com/jonathanwestberry/toronto-micro-atlas/main/data/proof/fg03/${snapshotDirectory}/snapshot-summary.csv`}>
                Download snapshot summary (CSV)
              </a>
            </li>
            <li>
              <a href={`https://github.com/jonathanwestberry/toronto-micro-atlas/tree/main/data/proof/fg03/${snapshotDirectory}`}>
                Open the dated proof package
              </a>
            </li>
          </ul>
        </section>

        <section id="credits">
          <p class="fg03-eyebrow">Credits</p>
          <h2>Publication record</h2>
          <p>
            Research, analysis, cartography, design, and writing by Jonathan Westberry.
            Built with Astro and MapLibre GL JS. Facility, pedestrian, and boundary
            records are from the City of Toronto. Scheduled service and station
            washroom records are from the TTC. Street context is from OpenStreetMap
            contributors.
          </p>
          <p>Analysis snapshot: {snapshotDate}. Page updated July 25, 2026.</p>
        </section>
      </div>
    </section>

    <nav class="fg03-series fg03-container" id="series" aria-label="Field guide series">
      <p class="fg03-eyebrow">Toronto Micro-Atlas field guides</p>
      <h2>More field guides</h2>
      <ol>
        <li>
          <a href={`${base}/guides/hidden-landscapes/`}>
            <span>Ravines & buried water</span>
            <strong>Hidden Landscapes</strong>
          </a>
        </li>
        <li>
          <a href={`${base}/guides/sidewalk-forest/`}>
            <span>The urban forest</span>
            <strong>Sidewalk Forest</strong>
          </a>
        </li>
        <li>
          <a href={`${base}/guides/`}>
            <span>Index</span>
            <strong>All field guides</strong>
          </a>
        </li>
      </ol>
    </nav>

    <script
      is:inline
      id="fg03-config"
      type="application/json"
      data-fg03-config
      set:html={config}
    />
    <script>
      import { registerWhenTorontoHasToGoLifecycle } from '../../../scripts/fg03-map';

      registerWhenTorontoHasToGoLifecycle();
    </script>
  </article>
</Base>
