---
import Base from '../../../layouts/Base.astro';
import Fg03Controls from '../../../components/Fg03Controls.astro';
import Fg03Status from '../../../components/Fg03Status.astro';
import Fg03MapFigure from '../../../components/Fg03MapFigure.astro';
import Fg03Legend from '../../../components/Fg03Legend.astro';
import Fg03Results from '../../../components/Fg03Results.astro';
import '../../../styles/fg03.css';
import { base, config, gatePassed, guideDescription, manifest } from '../../../data/fg03';

const guideHref = `${base}/guides/when-toronto-has-to-go/`;
---

<Base
  title="When Toronto Has to Go, full map"
  description={guideDescription}
  ogImage="/social/og-when-toronto-has-to-go.jpg"
  canonicalPath="/guides/when-toronto-has-to-go/"
  fullHeight
  preloadFonts={["bebas", "sourceSerif"]}
  guideTheme="fg03"
>
  <article
    class="fg03 fg03--map-route"
    data-fg03-root
    data-fg03-expanded="true"
    data-fg03-runtime="progressive"
    data-fg03-snapshot-date={manifest.snapshotDate}
    data-fg03-gate-status={gatePassed ? 'passed' : 'failed'}
  >
    <h1 class="visually-hidden">When Toronto Has to Go, full map</h1>

    {
      gatePassed ? (
        <div class="fg03-map-route-layout" data-fg03-gate="passed">
          {/*
            The filters and the ranked list travel with the map. Everything the
            map plots is also in this list, so the expanded view keeps the
            guide's promise that nothing is map-only.
          */}
          {/*
            The rail carries a real h2, not just an aria-label. Fg03Results
            opens at h3 because on the guide page it sits under that page's
            h2; on this route the only heading above it was the h1, so the
            outline jumped h1 -> h3. Naming the rail with a heading fixes the
            skip and gives the landmark its name from one place instead of
            two. The heading is hidden because the rail is visually obvious
            and a visible title here would just repeat the controls below it.
          */}
          <aside class="fg03-map-route-rail" aria-labelledby="fg03-rail-title">
            <h2 id="fg03-rail-title" class="visually-hidden">Filters and ranked results</h2>
            <Fg03Controls helpAtFoot />
            {/*
              The key, on the route with the biggest map. The figure's own copy
              is hidden here because a full-height map leaves no room under it,
              and the CSS that hid it once claimed the legend had moved in with
              the controls, which it never had. Now it has: folded by default
              after the first visit, directly under the last thing the reader
              chose to show on the map.
            */}
            <Fg03Legend collapsible id="fg03-rail-legend" />
            <Fg03Status />
            <Fg03Results />
          </aside>

          <Fg03MapFigure expanded />
        </div>
      ) : (
        <div class="fg03-map-route-withheld">
          <h2>Proof published, recommendations withheld</h2>
          <p>
            The intervention audit did not pass every product-gate condition, so this
            edition does not publish rankings or recommendation map layers.
          </p>
          <p>Gate reason: {manifest.gate.reason}</p>
          <p><a href={guideHref}>Read the guide</a></p>
        </div>
      )
    }

    <noscript>
      <div class="fg03-map-route-withheld">
        <p>
          The interactive map needs JavaScript.
          <a href={guideHref}>Read the guide</a>, which publishes the four-snapshot proof
          and the full default ranking without it.
        </p>
      </div>
    </noscript>

    <script is:inline id="fg03-config" type="application/json" data-fg03-config set:html={config} />
    <script>
      import { registerWhenTorontoHasToGoLifecycle } from '../../../scripts/fg03-map';

      registerWhenTorontoHasToGoLifecycle();
    </script>
  </article>
</Base>

<style is:global>
  /* Map left, filters and ranking right. The map gets the room because that is
     what this route exists for; the rail carries the controls and the fallback
     list, and scrolls on its own so the map never moves. */
  body[data-full-height] .fg03--map-route {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .fg03-map-route-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 26rem);
    flex: 1;
    min-height: 0;
  }

  .fg03-map-route-rail {
    grid-column: 2;
    grid-row: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-4);
    border-left: 1px solid var(--fg03-rule, var(--atlas-line));
    background: var(--fg03-paper, var(--atlas-ground));
  }

  .fg03-map-route-layout > .fg03-map-figure {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .fg03-map-route-layout .fg03-map-frame {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .fg03-map-route-layout .map-stage--expanded {
    flex: 1;
    min-height: 0;
  }

  .fg03-map-route-layout .map-stage--expanded .map-stage__frame {
    flex: 1;
    min-height: 0;
  }

  .fg03-map-route-layout .fg03-map {
    height: 100%;
    min-height: 0;
  }

  /* The figure's own legend copy and the keyboard instructions are hidden here
     because the rail now carries both: the legend as a disclosure above the
     status line, the keys inside "How to read this map". The howto legend is
     exempt, or the disclosure would open on an empty box. */
  .fg03-map-route-layout .fg03-map-frame > .fg03-legend,
  .fg03-map-route-layout .fg03-map-instructions {
    display: none;
  }

  /* The caption stays. Hiding the whole figcaption also took the snapshot date
     with it, which is the one thing a dated map cannot be published without.
     The attribution half goes, because MapLibre's own attribution control is
     already in the bottom-left corner of this map saying the same thing. */
  .fg03-map-route-layout .fg03-map-figure figcaption {
    border-top: 0;
    padding: 0.5rem var(--space-4);
  }

  .fg03-map-route-layout .fg03-map-figure figcaption [data-fg03-caption-attribution] {
    display: none;
  }

  /* The rail is a column, not a page width. The search field and the action
     buttons sit side by side on the guide, where there is room; here that
     squeezes "Clear search" onto two cramped lines, so they stack. */
  .fg03-map-route-rail .fg03-control-tools {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }

  .fg03-map-route-rail .fg03-search > div {
    grid-template-columns: minmax(0, 1fr);
  }

  .fg03-map-route-rail .fg03-control-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .fg03-map-route-withheld {
    padding: var(--space-8);
    max-width: 60ch;
  }

  /* Below the split, the rail becomes a sheet under the map rather than a
     column too narrow to read. */
  @media (max-width: 900px) {
    .fg03-map-route-layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 55svh minmax(0, 1fr);
    }

    .fg03-map-route-layout > .fg03-map-figure {
      grid-column: 1;
      grid-row: 1;
    }

    .fg03-map-route-rail {
      grid-column: 1;
      grid-row: 2;
      border-left: none;
      border-top: 1px solid var(--fg03-rule, var(--atlas-line));
    }
  }
</style>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
