---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<Base
  title="About"
  description="Toronto Micro-Atlas is an independent publication by Jonathan Westberry, a mapmaker and designer based in Toronto."
>
  <div class="page-wrapper">
    <div class="about-layout">
      <article class="about-article" aria-labelledby="about-title">

        <header class="about-header" data-reveal>
          <h1 class="about-title" id="about-title">About</h1>
          <div class="about-rule" role="presentation" aria-hidden="true"></div>
        </header>

        <div class="about-body">
          <p class="about-lede" data-reveal style="--reveal-delay: 40ms">Toronto Micro-Atlas is an independent publication by Jonathan Westberry, a mapmaker and designer based in Toronto.</p>

          <div class="about-prose prose" data-reveal style="--reveal-delay: 80ms">
            <p>The atlas is organized as guides. Each one explores a specific way of noticing or using the city. A guide is a curated collection, not an exhaustive database: it takes a position on what is worth paying attention to and why, and it makes that position readable through interactive maps and location entries built on real geographic data. The maps are drawn to be read as objects, not just used for navigation.</p>

            <p>Guides take time. The atlas grows as guides are finished, and existing guides keep improving after they ship. The work is made in Toronto.</p>
          </div>
        </div>

        <section class="about-guides" aria-labelledby="about-guides-title" data-reveal>
          <p class="about-guides-kicker">Published field guides</p>
          <h2 id="about-guides-title">Four ways to read the city</h2>
          <ol>
            <li>
              <a href={`${base}/guides/hidden-landscapes/`} data-astro-reload>
                <span>01</span>
                <strong>Hidden Landscapes</strong>
              </a>
            </li>
            <li>
              <a href={`${base}/guides/sidewalk-forest/`} data-astro-reload>
                <span>02</span>
                <strong>Sidewalk Forest</strong>
              </a>
            </li>
            <li>
              <a href={`${base}/guides/when-toronto-has-to-go/`} data-astro-reload>
                <span>03</span>
                <strong>When Toronto Has to Go</strong>
              </a>
            </li>
            <li>
              <a href={`${base}/guides/out-of-the-sun/`} data-astro-reload>
                <span>04</span>
                <strong>Out of the Sun</strong>
              </a>
            </li>
          </ol>
        </section>

        <nav class="about-nav" aria-label="Site navigation" data-reveal>
          <a href={`${base}/`} class="about-back">Toronto Micro-Atlas</a>
        </nav>

      </article>
    </div>
  </div>
</Base>

<style>
  /* ============================================================
     Page layout: centered column within page-wrapper
     ============================================================ */

  .about-layout {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .about-article {
    width: 100%;
    max-width: var(--measure);
  }

  /* ============================================================
     Header
     ============================================================ */

  .about-header {
    margin-bottom: var(--space-12);
  }

  .about-title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--text-4xl);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .about-rule {
    width: 3rem;
    height: 2px;
    background-color: var(--landscape);
  }

  /* ============================================================
     Body
     ============================================================ */

  .about-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  /* Lede paragraph: larger, tighter measure */
  .about-lede {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.7;
    color: var(--ink-2);
    max-width: var(--measure-lede);
  }

  /* Remaining prose via global .prose classes */
  .about-prose {
    max-width: var(--measure);
  }

  .about-guides {
    margin-bottom: var(--space-12);
    border-top: 1px solid var(--street-minor);
    padding-top: var(--space-8);
  }

  .about-guides-kicker {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-3);
  }

  .about-guides h2 {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--text-2xl);
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: var(--space-6);
  }

  .about-guides ol {
    list-style: none;
    border-top: 1px solid var(--street-minor);
  }

  .about-guides li {
    border-bottom: 1px solid var(--street-minor);
  }

  .about-guides a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    min-height: 3rem;
    padding-block: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  .about-guides a:hover {
    color: var(--threshold);
  }

  .about-guides a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .about-guides span {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .about-guides strong {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--text-lg);
  }

  /* ============================================================
     Footer nav
     ============================================================ */

  .about-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--street-minor);
  }

  .about-back,
  .about-guide-link {
    position: relative;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  /* SC 2.5.8: grown with a pseudo-element rather than padding, so the hit
     area changes and the layout does not. Same technique as the site nav. */
  .about-back::before,
  .about-guide-link::before {
    content: '';
    position: absolute;
    inset: -6px -4px;
  }

  .about-back:hover,
  .about-guide-link:hover {
    color: var(--threshold);
  }

  .about-back:focus-visible,
  .about-guide-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-back,
    .about-guide-link {
      transition: none;
    }
  }
</style>
