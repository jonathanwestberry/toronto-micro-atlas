# Copy to .env and fill in. .env is gitignored; this file is not, and must
# never carry a real value.
#
# R2 holds the shade tile pyramid for the Throwing Shade guide. The pyramid is
# 9,555 files, and Cloudflare Pages allows 20,000 per deployment, so the tiles
# are served from R2 rather than shipped with the site. See
# data/scripts/34_fg04_upload.py.
#
# These are NOT the Cloudflare API token used for DNS and Pages. That token
# has no R2 permission. Make an R2 token instead: Cloudflare dashboard,
# R2 > API Tokens > Create, permission "Object Read & Write". It hands back an
# access key and a secret, and shows the secret once.

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
