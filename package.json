{
  "name": "toronto-micro-atlas",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "maps": "node scripts/build-contextual-maps.mjs",
    "build-hero-map": "node scripts/build-hero-map.mjs",
    "check": "astro check",
    "test:web": "node --experimental-strip-types --test tests/atlas-events.test.mjs tests/fg03-state.test.mjs tests/fg03-results.test.mjs tests/fg03-map.test.mjs tests/fg04-core.test.mjs tests/fg04-point.test.mjs tests/fg04-runtime.test.mjs tests/fg04-state.test.mjs tests/fg04-streets.test.mjs tests/map-url.test.mjs tests/map-stage.test.mjs",
    "test:web:contract": "node --test tests/fg03-contract.test.mjs tests/fg04-content.test.mjs tests/fg04-release.test.mjs tests/seo-meta.test.mjs",
    "verify:fg04-browser": "node scripts/verify-fg04-browser-decode.mjs",
    "verify:fg04-explorer": "node scripts/verify-fg04-selected-hour.mjs",
    "verify:fg04-release": "node scripts/verify-fg04-release.mjs",
    "test": "npm run test:web && npm run check && npm run build && npm run test:web:contract"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "7.1.3",
    "maplibre-gl": "^5.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "d3-geo": "^3.1.1",
    "typescript": "^5.8.3"
  }
}
