/index.html
  Cache-Control: public, no-cache, must-revalidate, no-transform

/about/*
  Cache-Control: public, no-cache, must-revalidate, no-transform

/guides/*
  Cache-Control: public, no-cache, must-revalidate, no-transform

/404.html
  Cache-Control: public, no-cache, must-revalidate, no-transform

/data/fg03/2026-07-21/manifest.json
  Cache-Control: public, no-cache, must-revalidate

